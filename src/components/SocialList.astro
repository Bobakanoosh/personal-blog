---
import { Icon } from "astro-icon/components";

/** 
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/jack-englund/",
		name: "mdi:linkedin",
	},
	{
		friendlyName: "Github",
		link: "https://github.com/Bobakanoosh",
		name: "mdi:github",
	},
];
---

<nav aria-label="Social links" class="ms-auto">
	<ul class="flex items-center gap-x-1">
		{
			socialLinks.map(({ friendlyName, link, name }) => (
				<li class="flex">
					<a
						class="inline-flex rounded-md p-1.5 ring-zinc-400 transition-all hover:ring-2"
						href={link}
						rel="noopener noreferrer"
						target="_blank"
					>
						<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
