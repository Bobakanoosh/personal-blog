---
import Lightbox from "@/components/Lightbox.astro";
import PortfolioItem from "@/components/PortfolioItem.astro";
import { portfolio } from "@/data/portfolio";
import PageLayout from "@/layouts/Base.astro";

const technologies: { href: string; title: string }[] = [
	{
		href: "https://vuejs.org/",
		title: "Vue.js",
	},
	{
		href: "https://nuxt.com",
		title: "Nuxt",
	},
	{
		href: "https://tailwindcss.com/",
		title: "Tailwind CSS",
	},
	{
		href: "https://www.typescriptlang.org/",
		title: "TypeScript",
	},
	{
		href: "https://nodejs.org/",
		title: "Node.js",
	},
	{
		href: "https://adonisjs.com/",
		title: "AdonisJS",
	},
	{
		href: "https://learn.microsoft.com/en-us/dotnet/csharp/",
		title: "C#",
	},
	{
		href: "https://ai-sdk.dev/",
		title: "AI SDK",
	},
	{
		href: "https://vitest.dev/",
		title: "Vitest",
	},
	{
		href: "https://www.claude.com/product/claude-code",
		title: "Claude Code",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-4">Hello World!</h1>
		<p>
			I'm Jack Englund, a product engineer that's embracing agentic development. I've spent the last several years building products in gaming
			and fintech: stats sites for competitive games, a developer platform for in-game overlays, and tools for private markets
			investing. In my personal time I spend a lot of time at the gym, skiing, playing video games, and reading.
		</p>
	</section>
	<section aria-labelledby="work-heading" class="mt-16 scroll-mt-8" id="work">
		<h2 class="title mb-8 text-xl" id="work-heading">Work</h2>
		<ul class="flex flex-col gap-16">
			{
				portfolio.map((item) => (
					<li>
						<PortfolioItem item={item} />
					</li>
				))
			}
		</ul>
	</section>
	<section aria-labelledby="technologies-heading" class="mt-16 scroll-mt-8" id="technologies">
		<h2 class="title mb-4 text-xl" id="technologies-heading">Technologies</h2>
		<p class="mb-4">Here are some technologies that I love:</p>
		<ul class="flex flex-wrap gap-4">
			{
				technologies.map(({ href, title }) => (
					<li>
						<a class="cactus-link" href={href} rel="noopener noreferrer" target="_blank">
							{title}
						</a>
					</li>
				))
			}
		</ul>
	</section>
	<Lightbox />
</PageLayout>
