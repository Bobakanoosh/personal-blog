# Cloudflare Pages response headers: https://developers.cloudflare.com/pages/configuration/headers/

# Astro build output. Filenames contain a content hash, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Not hashed. Cache for a week, and serve stale for a day while revalidating.
/portfolio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
